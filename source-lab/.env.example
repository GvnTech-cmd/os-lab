# Export these variables before invoking labctl source, or set them in the caller.
# The launcher never evaluates a shell .env file.
# SOURCE_LAB_STORAGE=/absolute/path/to/private/source-lab-storage
# SOURCE_LAB_RESOURCES=/absolute/path/to/authorized-resource-root
# SOURCE_LAB_PYTHON=/absolute/path/to/python3
# IQ_SESSION_HMAC_KEY_FILE=/absolute/path/to/private/session-hmac.key
